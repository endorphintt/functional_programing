_opam/
_build/
*.install
*.merlin
*.cmi
*.cmo
*.cmx
*.cmt
*.cmti
*.o
*.a
*.so
*.dylib
*.exe
*.bc
*.native

node_modules/
.next/
dist/
build/
out/
coverage/
.turbo/
.parcel-cache/
.vite/
.vscode/
.env
.env.*
EOF

/frontend/app/out

/frontend/app/.DS_Store
*.swp
/frontend/app/*.swo

/frontend/app/node_modules/
/frontend/app/.next/

/frontend/app/yarn-error.log

/frontend/app/.bsb.lock
/frontend/app/.merlin
/frontend/app/lib/
